def main() -> int:
    ap = argparse.ArgumentParser(prog="brain", description="the deterministic layer of a personal intelligence")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("index", help="rebuild the full-text index over memory/")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(func=lambda a: (print(f"indexed {build_index(a.verbose)} notes"), 0)[1])

    p = sub.add_parser("search", help="full-text search the library")
    p.add_argument("query", nargs="+")
    p.add_argument("--type", help="person | company | project | meeting | decision | daily | inbox | topic")
    p.add_argument("--since", help="YYYY-MM-DD, by note date or last update")
    p.add_argument("--until", help="YYYY-MM-DD")
    p.add_argument("--loose", action="store_true", help="match any of the words, not all")
    p.add_argument("--recent", action="store_true", help="newest first instead of best match first")
    p.add_argument("-n", "--limit", type=int, default=10)
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("who", help="everything the library knows about a person")
    p.add_argument("name", nargs="+")
    p.add_argument("--since", help="YYYY-MM-DD, only mentions on or after")
    p.add_argument("-n", "--limit", type=int, default=15)
    p.set_defaults(func=cmd_who)

    p = sub.add_parser("new", help="create a note from a template")
    p.add_argument("kind", choices=list(TYPE_DIRS))
    p.add_argument("title", nargs="*")
    p.add_argument("--date")
    p.add_argument("--set", action="append", metavar="KEY=VALUE")
    p.add_argument("--force", action="store_true", help="create a person even if a similar file exists")
    p.set_defaults(func=cmd_new)

    p = sub.add_parser("today", help="path to today's daily note, creating it if needed")
    p.set_defaults(func=cmd_today)

    p = sub.add_parser("links", help="inbound and outbound links for a note")
    p.add_argument("path")
    p.set_defaults(func=cmd_links)

    p = sub.add_parser("recent", help="most recent notes by date")
    p.add_argument("--type")
    p.add_argument("--days", type=int)
    p.add_argument("-n", "--limit", type=int, default=20)
    p.set_defaults(func=cmd_recent)

    p = sub.add_parser("status", help="library size, freshness, unprocessed inbox")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("health", help="did the routines run: brief, evening, review, plan, word cap, dashes, per day")
    p.add_argument("--days", type=int, default=7)
    p.set_defaults(func=cmd_health)

    p = sub.add_parser("chases", help="open chase-ledger items with their age, stale ones flagged")
    p.add_argument("--who", help="only items naming this person")
    p.add_argument("--mine", action="store_true", help="only what you owe others")
    p.add_argument("--by", choices=["person"], help="group by owner")
    p.add_argument("--lint", action="store_true", help="items with no date, no link, or no known owner")
    p.set_defaults(func=cmd_chases)

    p = sub.add_parser("close", help="strike brief items whose Gmail thread got a reply or whose Hespia task got ticked")
    p.add_argument("--gmail", nargs="+", metavar="THREAD_ID")
    p.add_argument("--hespia", nargs="+", metavar="TASK_ID")
    p.add_argument("--date", help="YYYY-MM-DD to stamp, default today")
    p.add_argument("--days", type=int, default=7, help="how far back to look in memory/daily")
    p.add_argument("--dry-run", action="store_true", help="print what would be struck, change nothing")
    p.set_defaults(func=cmd_close)

    p = sub.add_parser("repeats", help="brief items that have appeared in consecutive briefs")
    p.add_argument("--days", type=int, default=14)
    p.add_argument("--min", type=int, default=2, help="show items with at least this many consecutive briefs")
    p.set_defaults(func=cmd_repeats)

    p = sub.add_parser("closed", help="struck brief items, and which have an open chase behind them")
    p.add_argument("--days", type=int, default=7)
    p.set_defaults(func=cmd_closed)

    p = sub.add_parser("carried", help="open brief items from recent days, deduped, for Carried forward")
    p.add_argument("--days", type=int, default=7)
    p.set_defaults(func=cmd_carried)

    p = sub.add_parser("top3", help="the day's Top 3 from each brief, the evening's verdict per task, and who sat undone")
    p.add_argument("--days", type=int, default=7)
    p.set_defaults(func=cmd_top3)

    p = sub.add_parser("actions", help="action checkboxes from meeting notes")
    p.add_argument("--open", action="store_true", help="unchecked only")
    p.add_argument("--person", help="owner name or slug")
    p.set_defaults(func=cmd_actions)

