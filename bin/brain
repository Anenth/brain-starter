    p.add_argument("path")
    p.set_defaults(func=cmd_retire)

    p = sub.add_parser("lint", help="style (em dashes) and structure (dangling links, stale projects, thin files)")
    p.add_argument("--style", action="store_true")
    p.add_argument("--structure", action="store_true")
    p.add_argument("--path", nargs="+", help="style-check only these files")
    p.add_argument("--strict", action="store_true", help="exit 1 on any finding")
    p.add_argument("--tasks", metavar="FILE",
                   help="every Hespia task id, done or open (JSON or one per line): flag hespia: tags that are not tasks")
    p.set_defaults(func=cmd_lint)

    p = sub.add_parser("sample", help="pick the month's outputs for a read-through, or read the notes back from the sheet")
    p.add_argument("-n", type=int, default=15, help="how many to pick (default 15)")
    p.add_argument("--days", type=int, default=30)
    p.add_argument("--month", help="YYYY-MM. The seed and the sheet's name. Default this month")
    p.add_argument("--write", action="store_true", help="write memory/inbox/review-YYYY-MM.md. Never overwrites")
    p.add_argument("--notes", metavar="SHEET", help="print the notes the owner wrote in a review sheet")
    p.add_argument("--json", action="store_true", help="with --notes, as JSON")
    p.set_defaults(func=cmd_sample)

    p = sub.add_parser("priorities", help="days since each stated priority in profile.md was touched")
    p.set_defaults(func=cmd_priorities)

    p = sub.add_parser("decisions", help="decisions, and which are due a revisit or an outcome")
    p.add_argument("--due", action="store_true", help="only the ones due a look")
    p.set_defaults(func=cmd_decisions)

    p = sub.add_parser("topics", help="compiled topic pages, and which sources moved since the last compile")
    p.add_argument("topic", nargs="?", help="one topic by slug or part of it, with the changed notes listed")
    p.add_argument("--stale", action="store_true", help="only topics with changed sources or new mentions")
    p.add_argument("--gaps", action="store_true", help="open lines under ## Gaps on every topic page")
    p.set_defaults(func=cmd_topics)

    p = sub.add_parser("meetings", help="which Fathom recordings still need to become memory, and which calendar meetings left no trace")
    p.add_argument("fathom", nargs="?", help="file with the Fathom list_meetings output (text or JSON), or - for stdin")
    p.add_argument("--calendar", help="file with Calendar list_events JSON: meetings that left no trace in the library")
    p.add_argument("--all", action="store_true", help="also print the done and skipped rows")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_meetings)

    p = sub.add_parser("improvements", help="open items in memory/improvements.md, seen counts, possible fixes in git")
    p.set_defaults(func=cmd_improvements)

    p = sub.add_parser("config", help="check brain.json: who this library belongs to, their timezone, their Hespia org")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("secrets", help="scan tracked files for anything that looks like a credential")
    p.add_argument("--staged", action="store_true", help="only files staged for commit")
    p.set_defaults(func=cmd_secrets)

    args = ap.parse_args()
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        _strip_color()
    return args.func(args) or 0


def _strip_color():
    real_print = print

    def plain(*a, **kw):
        a = tuple(re.sub(r"\x1b\[[0-9;]*m", "", x) if isinstance(x, str) else x for x in a)
        real_print(*a, **kw)

    globals()["print"] = plain


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        # Piping into `head` closes the pipe early. Exit quietly rather than
        # dumping a traceback, and redirect stdout so Python's shutdown flush
        # doesn't raise a second time on the way out.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
